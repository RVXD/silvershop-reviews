{
    "name": "silvershop/reviews",
    "description": "Product and shop reviews with star ratings, moderation, verified purchases and aggregate rating (JSON-LD) for SilverShop.",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "silvershop",
        "ecommerce",
        "reviews",
        "ratings"
    ],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "SilverShop Contributors",
            "homepage": "https://github.com/silvershop/silvershop-reviews/graphs/contributors"
        }
    ],
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6.0",
        "silvershop/core": "^6"
    },
    "require-dev": {
        "cambis/silverstan": "^2.1",
        "silverstripe/recipe-testing": "^4",
        "silverstripe/sqlite3": "^4",
        "squizlabs/php_codesniffer": "^3.0"
    },
    "suggest": {
        "silvershop/store-profile": "Shared shop identity used as the sender for review-invitation emails (v2).",
        "silverstripe/queuedjobs": "Scheduled review-invitation emails after an order is fulfilled (v2).",
        "silverstripe/spamprotection": "Pluggable spam protection (reCAPTCHA/hCaptcha/...) auto-enabled on the public forms."
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "stan": "vendor/bin/phpstan analyse --configuration=phpstan.neon --memory-limit=-1",
        "lint": "vendor/bin/phpcs",
        "lint:fix": "vendor/bin/phpcbf"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true,
            "php-http/discovery": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "SilverShop\\Reviews\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SilverShop\\Reviews\\Tests\\": "tests/php/"
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
