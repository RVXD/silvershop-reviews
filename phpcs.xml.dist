<?xml version="1.0"?>
<ruleset name="silvershop-reviews">
    <description>PHP_CodeSniffer configuration</description>

    <file>src</file>
    <file>tests</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="p"/>

    <!-- Line-length (and other) warnings are reported but don't fail the build; real errors still do. -->
    <config name="ignore_warnings_on_exit" value="1"/>

    <rule ref="PSR12">
        <!-- SilverStripe template/contract methods are PascalCase by convention (e.g. ShowInTable()). -->
        <exclude name="PSR1.Methods.CamelCapsMethodName"/>
    </rule>

    <!-- SilverStripe test bootstrap: global Page/PageController stubs + require_once -->
    <rule ref="PSR1.Classes.ClassDeclaration.MissingNamespace">
        <exclude-pattern>tests/bootstrap.php</exclude-pattern>
    </rule>
    <rule ref="PSR1.Files.SideEffects.FoundWithSymbols">
        <exclude-pattern>tests/bootstrap.php</exclude-pattern>
        <!-- RatingFacet implements an OPTIONAL dependency's interface (silvershop/search) and is declared only
             when it is present (if-guarded), so the module boots standalone without search. -->
        <exclude-pattern>src/Search/RatingFacet.php</exclude-pattern>
    </rule>

    <!-- The if-guarded facet keeps its body at class indent (not nested under the guard) to keep the diff
         minimal; skip scope-indent for it only. -->
    <rule ref="Generic.WhiteSpace.ScopeIndent">
        <exclude-pattern>src/Search/RatingFacet.php</exclude-pattern>
    </rule>

    <!-- The facet wraps the class in an if (interface_exists) guard, so the class docblock no longer sits
         directly under the file header; skip the strict file-header ordering sniff for it. -->
    <rule ref="PSR12.Files.FileHeader">
        <exclude-pattern>src/Search/RatingFacet.php</exclude-pattern>
    </rule>

    <!-- TestOnly stand-in DataObjects live beside the test that uses them -->
    <rule ref="PSR1.Classes.ClassDeclaration.MultipleClasses">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
</ruleset>
